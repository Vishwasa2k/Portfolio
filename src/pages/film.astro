---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { filmPhotos } from '../lib/photos';
---
<Base title="Film" description="Film photography - 35mm and medium format.">
  <div class="wrap film-page">
    <header class="page-head">
      <p class="eyebrow">35mm / 120</p>
      <h1>Film</h1>
      <p>Everything I have shot on film, across all albums. Stock and camera are listed under each frame.</p>
    </header>
    <Gallery photos={filmPhotos()} showFilter={false} />
  </div>
</Base>
