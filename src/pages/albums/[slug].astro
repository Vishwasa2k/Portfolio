---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { albums, photosInAlbum } from '../../lib/photos';

export function getStaticPaths() {
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}
const { album } = Astro.props;
const list = photosInAlbum(album.slug);
---
<Base title={album.title} description={album.description}>
  <h1 class="page-title">{album.title}</h1>
  {album.description && <p class="page-sub">{album.description}</p>}
  <Gallery photos={list} />
</Base>
