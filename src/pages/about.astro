---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="About">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>{site.name}</h1>
    </header>
    <div class="about">
      <p>{site.about}</p>
      <p>
        Get in touch: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</Base>
